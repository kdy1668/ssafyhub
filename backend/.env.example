DB_URL=jdbc:mysql://localhost:3306/ssafyhub?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

JWT_SECRET=replace_with_a_secure_random_secret
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=1800000
JWT_REFRESH_TOKEN_EXPIRATION_MILLIS=1209600000

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_PRESIGNED_URL_EXPIRATION_MINUTES=10
